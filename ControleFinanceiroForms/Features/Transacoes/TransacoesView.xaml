<UserControl x:Class="ControleFinanceiroForms.Features.Transacoes.TransacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControleFinanceiroForms.Features.Transacoes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1024"
             Background="#ffffff">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Transações" 
                       FontSize="36" FontWeight="Bold" Foreground="#101114" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Visualize, edite categorias e exclua suas transações importadas." 
                       FontSize="16" Foreground="#686b82" 
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Filtros de Mês/Ano -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Mês" FontSize="14" Foreground="#101114" Margin="0,0,0,4"/>
                <TextBox x:Name="MonthTextBox" 
                         Text="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8" FontSize="16" BorderBrush="#dedee5" BorderThickness="1"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="Ano" FontSize="14" Foreground="#101114" Margin="0,0,0,4"/>
                <TextBox x:Name="YearTextBox" 
                         Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8" FontSize="16" BorderBrush="#dedee5" BorderThickness="1"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Filtrar" VerticalAlignment="Bottom"
                    Command="{Binding LoadTransacoesCommand}"
                    Background="#7132f5" Foreground="#ffffff" 
                    FontSize="16" FontWeight="SemiBold" 
                    Padding="16,10" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Mensagem de erro -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#e02020" FontSize="14" Margin="0,0,0,8" />

        <!-- Grid de Transações -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Transacoes}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" Background="#ffffff" BorderBrush="#dedee5" 
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f8fa" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#dedee5"
                  RowEditEnding="DataGrid_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=C}" Width="120" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Categoria" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Categoria.Name}" VerticalAlignment="Center" Padding="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedValue="{Binding CategoryId, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Padding="4" FontSize="14" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ações" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Excluir" Background="Transparent" Foreground="#e02020" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteTransacaoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
