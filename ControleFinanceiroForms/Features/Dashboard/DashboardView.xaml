<UserControl x:Class="ControleFinanceiroForms.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControleFinanceiroForms.Features.Dashboard"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#ffffff">

    <UserControl.Resources>
        <!-- Estilo para os Cards de Resumo -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#dedee5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Conversor Simples de Cor para Status Geral -->
        <local:StatusColorConverter x:Key="StatusColorConverter"/>

        <!-- Template Customizado e Moderno para ProgressBar (Sem efeitos 3D) -->
        <Style TargetType="ProgressBar" x:Key="ModernProgressBarStyle">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#f4f4f6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título e Subtítulo -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Dashboard" 
                           FontSize="36" FontWeight="Bold" Foreground="#101114" 
                           Margin="0,0,0,4"/>
                <TextBlock Text="Acompanhamento passivo dos seus gastos e metas." 
                           FontSize="16" Foreground="#686b82"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#101114" FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="110" Margin="0,0,16,0" Padding="4"/>
                
                <TextBlock Text="Até:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#101114" FontWeight="SemiBold"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="110" Margin="0,0,16,0" Padding="4"/>
                
                <Button Content="Filtrar" Command="{Binding LoadDashboardCommand}"
                        Background="#7132f5" Foreground="#ffffff" FontWeight="SemiBold"
                        Padding="16,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Cards Superiores de Resumo -->
        <Grid Grid.Row="1" Margin="-8,0,-8,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card: Total Orçado -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL ORÇADO" FontSize="12" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TotalBudget, StringFormat=R$ \{0:N2\}}" FontSize="24" FontWeight="Bold" Foreground="#101114"/>
                </StackPanel>
            </Border>

            <!-- Card: Total Realizado -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="TOTAL GASTO" FontSize="12" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TotalSpent, StringFormat=R$ \{0:N2\}}" FontSize="24" FontWeight="Bold" Foreground="#101114"/>
                </StackPanel>
            </Border>

            <!-- Card: Saldo Restante -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="SALDO RESTANTE" FontSize="12" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding RemainingBudget, StringFormat=R$ \{0:N2\}}" FontSize="24" FontWeight="Bold" 
                               Foreground="{Binding IsGeneralOverBudget, Converter={StaticResource StatusColorConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progresso Orçamentário Geral -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Progresso Orçamentário Geral" FontSize="16" FontWeight="Bold" Foreground="#101114" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding GeneralProgress, StringFormat=\{0:F0\}%}" FontSize="16" FontWeight="Bold" Foreground="#7132f5" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Grid.Row="1" Value="{Binding GeneralProgress}" 
                             Foreground="{Binding IsGeneralOverBudget, Converter={StaticResource StatusColorConverter}}"
                             Style="{StaticResource ModernProgressBarStyle}"/>
            </Grid>
        </Border>

        <!-- Detalhes por Categoria -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Limites por Categoria" FontSize="20" FontWeight="Bold" Foreground="#101114" Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DashboardItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#dedee5" BorderThickness="0,0,0,1" Padding="0,16" Margin="0,0,16,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nome da Categoria -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CategoryName}" FontSize="16" FontWeight="SemiBold" Foreground="#101114" Margin="0,0,0,6"/>

                                    <!-- Progresso do Gasto -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormattedProgress}" FontSize="14" Foreground="#686b82" VerticalAlignment="Center" Margin="0,0,0,6"/>

                                    <!-- Barra de Progresso da Categoria -->
                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                                 Value="{Binding ProgressPercentage, Mode=OneWay}" 
                                                 Foreground="{Binding StatusColor}"
                                                 Style="{StaticResource ModernProgressBarStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Transações Recentes -->
        <Grid Grid.Row="4" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Transações Recentes" FontSize="20" FontWeight="Bold" Foreground="#101114" Margin="0,0,0,12"/>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#686b82"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#7132f5"/>
                                <Setter Property="BorderBrush" Value="#7132f5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Conta Corrente">
                    <DataGrid ItemsSource="{Binding CheckingTransactions}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,16,0,0"
                              Background="White" BorderBrush="#dedee5" BorderThickness="1" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=C}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Cartão de Crédito">
                    <DataGrid ItemsSource="{Binding CreditTransactions}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,16,0,0"
                              Background="White" BorderBrush="#dedee5" BorderThickness="1" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=C}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
