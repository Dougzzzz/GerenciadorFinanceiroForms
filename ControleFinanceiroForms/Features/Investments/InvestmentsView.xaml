<UserControl x:Class="ControleFinanceiroForms.Features.Investments.InvestmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControleFinanceiroForms.Features.Investments"
             xmlns:entities="clr-namespace:ControleFinanceiroForms.Data.Entities"
             xmlns:converters="clr-namespace:ControleFinanceiroForms.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
             
    <UserControl.Resources>
        <converters:EnumTranslationConverter x:Key="EnumTranslationConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Meus Investimentos" 
                       FontSize="36" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Registre periodicamente o valor total do seu patrimônio para acompanhar o crescimento." 
                       FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Valor Total (R$)" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewValue, UpdateSourceTrigger=LostFocus}" 
                          Padding="8" FontSize="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Operação" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <ComboBox SelectedItem="{Binding NewTipoOperacao}"
                          Padding="8" FontSize="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type entities:OperacaoInvestimento}">
                            <entities:OperacaoInvestimento>SnapshotTotal</entities:OperacaoInvestimento>
                            <entities:OperacaoInvestimento>Aporte</entities:OperacaoInvestimento>
                            <entities:OperacaoInvestimento>Retirada</entities:OperacaoInvestimento>
                        </x:Array>
                    </ComboBox.ItemsSource>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumTranslationConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="Conta" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewConta, UpdateSourceTrigger=PropertyChanged}" 
                          Padding="8" FontSize="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                <TextBlock Text="Tipo" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewTipoInvestimento, UpdateSourceTrigger=PropertyChanged}" 
                          Padding="8" FontSize="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="4" Margin="0,0,12,0">
                <TextBlock Text="Nota (Opcional)" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" 
                          Padding="8" FontSize="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}"/>
            </StackPanel>
            
            <Button Grid.Column="5" Content="Registrar" VerticalAlignment="Bottom"
                    Command="{Binding AddInvestmentCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="#ffffff" 
                    FontSize="16" FontWeight="SemiBold" 
                    Padding="16,10" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
        
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#e02020" FontSize="14" Margin="0,70,0,0" VerticalAlignment="Bottom" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Investments}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                  RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource AppBackgroundBrush}" 
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data do Registro" Binding="{Binding RecordedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="Valor" Binding="{Binding TotalValue, StringFormat=C}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="Operação" Binding="{Binding TipoOperacao, Converter={StaticResource EnumTranslationConverter}}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="Conta" Binding="{Binding Conta}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoInvestimento}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="Nota" Binding="{Binding Note}" Width="*" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Ações" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Excluir" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteInvestmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
