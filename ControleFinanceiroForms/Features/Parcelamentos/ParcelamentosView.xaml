<UserControl x:Class="ControleFinanceiroForms.Features.Parcelamentos.ParcelamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControleFinanceiroForms.Features.Parcelamentos"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#ffffff">

    <UserControl.Resources>
        <!-- Estilo para os Cards de Resumo -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#dedee5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Template Customizado e Moderno para ProgressBar -->
        <Style TargetType="ProgressBar" x:Key="ModernProgressBarStyle">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#f4f4f6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Layout split in columns -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Acompanhamento de Parcelamentos" 
                       FontSize="36" FontWeight="Bold" Foreground="#101114" 
                       Margin="0,0,0,4"/>
            <TextBlock Text="Cadastre compras ou dívidas parceladas e amortize o saldo com pagamentos parciais." 
                       FontSize="16" Foreground="#686b82"/>
        </StackPanel>

        <!-- Conteúdo Principal dividido em duas colunas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" /> <!-- Lista de Parcelamentos -->
                <ColumnDefinition Width="2*" /> <!-- Detalhes & Pagamentos -->
            </Grid.ColumnDefinitions>

            <!-- COLUNA ESQUERDA: Lista e Cadastro -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Form de Cadastro -->
                    <RowDefinition Height="Auto"/> <!-- Filtros -->
                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                </Grid.RowDefinitions>

                <!-- Cadastro de Novo Parcelamento -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Novo Parcelamento" FontSize="16" FontWeight="Bold" Foreground="#101114" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Descrição" FontSize="12" Foreground="#686b82" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewDescricao, UpdateSourceTrigger=PropertyChanged}" Padding="6" BorderBrush="#dedee5" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Valor Total" FontSize="12" Foreground="#686b82" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewValorTotal, UpdateSourceTrigger=PropertyChanged}" Padding="6" BorderBrush="#dedee5" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Parcelas" FontSize="12" Foreground="#686b82" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewNumeroParcelas, UpdateSourceTrigger=PropertyChanged}" Padding="6" BorderBrush="#dedee5" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Data Início" FontSize="12" Foreground="#686b82" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding NewDataInicio}" Padding="3" BorderBrush="#dedee5" BorderThickness="1"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="Adicionar" VerticalAlignment="Bottom"
                                    Command="{Binding AddParcelamentoCommand}"
                                    Background="#7132f5" Foreground="#ffffff" FontWeight="SemiBold" 
                                    Padding="16,8" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Filtros e Mensagem de Erro -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#e02020" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" Content="Ocultar Quitados" IsChecked="{Binding FiltroSomenteEmAberto}" 
                              FontSize="14" Foreground="#101114" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

                <!-- Tabela de Parcelamentos -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding VisibleParcelamentos}" SelectedItem="{Binding SelectedParcelamento}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          Background="#ffffff" BorderBrush="#dedee5" RowBackground="#ffffff" AlternatingRowBackground="#f8f8fa" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#dedee5" Cursor="Hand">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotal, StringFormat=C}" Width="1.2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Restante" Binding="{Binding SaldoRestante, StringFormat=C}" Width="1.2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Parcelas" Binding="{Binding FormattedParcelas}" Width="1.8*" IsReadOnly="True" />
                        
                        <!-- Coluna customizada de Progresso -->
                        <DataGridTemplateColumn Header="Progresso" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding FormattedProgress}" FontSize="11" Foreground="#686b82" Margin="0,0,0,2"/>
                                        <ProgressBar Value="{Binding PercentualQuitado}" Foreground="#7132f5" Style="{StaticResource ModernProgressBarStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ações" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Excluir" Background="Transparent" Foreground="#7132f5" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.DeleteParcelamentoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- COLUNA DIREITA: Detalhes do Parcelamento Selecionado e Pagamentos -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedParcelamento}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Novo Pagamento -->
                    <RowDefinition Height="*"/>    <!-- Histórico de Pagamentos -->
                </Grid.RowDefinitions>

                <!-- Registrar Novo Pagamento -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Amortizar Saldo Devedor" FontSize="16" FontWeight="Bold" Foreground="#101114"/>
                            <TextBlock Text="{Binding SelectedParcelamento.Descricao, StringFormat=Registrar pagamento para: \{0\}}" FontSize="12" Foreground="#686b82"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Valor Pago" FontSize="12" Foreground="#686b82" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewValorPago, UpdateSourceTrigger=PropertyChanged}" Padding="6" BorderBrush="#dedee5" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                                <TextBlock Text="Data Pagamento" FontSize="12" Foreground="#686b82" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding NewDataPagamento}" Padding="3" BorderBrush="#dedee5" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                                <TextBlock Text="Nota (Opcional)" FontSize="12" Foreground="#686b82" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewPagamentoNota, UpdateSourceTrigger=PropertyChanged}" Padding="6" BorderBrush="#dedee5" BorderThickness="1"/>
                            </StackPanel>

                            <Button Grid.Row="1" Grid.Column="2" Content="Pagar" VerticalAlignment="Bottom"
                                    Command="{Binding AddPagamentoCommand}"
                                    Background="#7132f5" Foreground="#ffffff" FontWeight="SemiBold" 
                                    Padding="24,8" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Histórico de Pagamentos -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,16,16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Histórico de Amortizações" FontSize="16" FontWeight="Bold" Foreground="#101114" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedParcelamentoPagamentos}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" CanUserDeleteRows="False" Background="#ffffff" BorderBrush="#dedee5" 
                                  RowBackground="#ffffff" AlternatingRowBackground="#f8f8fa" HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#dedee5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding DataPagamento, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Valor" Binding="{Binding ValorPago, StringFormat=C}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Nota" Binding="{Binding Nota}" Width="*" IsReadOnly="True" />
                                
                                <DataGridTemplateColumn Header="Ações" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Excluir" Background="Transparent" Foreground="#7132f5" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.DeletePagamentoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
