<UserControl x:Class="ControleFinanceiroForms.Features.Transacoes.TransacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControleFinanceiroForms.Features.Transacoes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1024"
             Background="#ffffff">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ObjectDataProvider x:Key="TipoTransacaoEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:TipoTransacao"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Transações" 
                       FontSize="36" FontWeight="Bold" Foreground="#101114" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Visualize, edite categorias e exclua suas transações importadas." 
                       FontSize="16" Foreground="#686b82" 
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Filtros de Mês/Ano -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ Nova Transação" Command="{Binding OpenAddModalCommand}"
                        AutomationProperties.AutomationId="BtnNovaTransacao"
                        Background="#101114" Foreground="#ffffff" FontWeight="SemiBold"
                        Padding="16,8" BorderThickness="0" Cursor="Hand" Margin="0,0,24,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#101114" FontWeight="SemiBold"/>
                <DatePicker AutomationProperties.AutomationId="DpStartDate" SelectedDate="{Binding StartDate}" Width="110" Margin="0,0,16,0" Padding="4"/>
                
                <TextBlock Text="Até:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#101114" FontWeight="SemiBold"/>
                <DatePicker AutomationProperties.AutomationId="DpEndDate" SelectedDate="{Binding EndDate}" Width="110" Margin="0,0,16,0" Padding="4"/>
                
                <Button AutomationProperties.AutomationId="BtnFiltrarTransacoes" Content="Filtrar" Command="{Binding LoadTransacoesCommand}"
                        Background="#7132f5" Foreground="#ffffff" FontWeight="SemiBold"
                        Padding="16,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Mensagem de erro -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#e02020" FontSize="14" Margin="0,0,0,8" />

        <!-- Grid de Transações -->
        <DataGrid Grid.Row="3" AutomationProperties.AutomationId="DgTransacoes" ItemsSource="{Binding Transacoes}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" Background="#ffffff" BorderBrush="#dedee5" 
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f8fa" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#dedee5"
                  RowEditEnding="DataGrid_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=C}" Width="120" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Categoria" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Categoria.Name}" VerticalAlignment="Center" Padding="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedValue="{Binding CategoryId, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Padding="4" FontSize="14" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ações" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Excluir" Background="Transparent" Foreground="#e02020" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteTransacaoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Modal Nova Transação -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsAddModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#ffffff" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="20" ShadowDepth="4"/>
                </Border.Effect>
                
                <StackPanel>
                    <TextBlock Text="Nova Transação" FontSize="20" FontWeight="Bold" Foreground="#101114" Margin="0,0,0,16"/>

                    <TextBlock Text="Descrição" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,4"/>
                    <TextBox AutomationProperties.AutomationId="TxtDescricao" Text="{Binding NewTransacaoDescricao, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12" />

                    <TextBlock Text="Valor" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,4"/>
                    <TextBox AutomationProperties.AutomationId="TxtValor" Text="{Binding NewTransacaoValor, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Padding="8" Margin="0,0,0,12" />

                    <TextBlock Text="Data" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,4"/>
                    <DatePicker AutomationProperties.AutomationId="DpData" SelectedDate="{Binding NewTransacaoData}" Padding="4" Margin="0,0,0,12" />

                    <TextBlock Text="Tipo" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,4"/>
                    <ComboBox AutomationProperties.AutomationId="CmbTipo" ItemsSource="{Binding Source={StaticResource TipoTransacaoEnum}}" SelectedItem="{Binding NewTransacaoTipo}" Padding="8" Margin="0,0,0,12" />

                    <TextBlock Text="Categoria" FontWeight="SemiBold" Foreground="#686b82" Margin="0,0,0,4"/>
                    <ComboBox AutomationProperties.AutomationId="CmbCategoria" ItemsSource="{Binding Categories}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding NewTransacaoCategoriaId}" Padding="8" Margin="0,0,0,24" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#e02020" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" AutomationProperties.AutomationId="BtnCancelarTransacao" Content="Cancelar" Command="{Binding CloseAddModalCommand}"
                                Background="#f0f0f5" Foreground="#101114" FontWeight="SemiBold" Padding="0,10" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" AutomationProperties.AutomationId="BtnSalvarTransacao" Content="Salvar" Command="{Binding AddTransacaoCommand}"
                                Background="#7132f5" Foreground="#ffffff" FontWeight="SemiBold" Padding="0,10" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
