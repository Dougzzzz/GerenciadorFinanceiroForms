<Window x:Class="ControleFinanceiroForms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControleFinanceiroForms"
        xmlns:inv="clr-namespace:ControleFinanceiroForms.Features.Investments"
        xmlns:import="clr-namespace:ControleFinanceiroForms.Features.ImportTransactions"
        xmlns:categories="clr-namespace:ControleFinanceiroForms.Features.Categories"
        xmlns:dashboard="clr-namespace:ControleFinanceiroForms.Features.Dashboard"
        xmlns:parc="clr-namespace:ControleFinanceiroForms.Features.Parcelamentos"
        mc:Ignorable="d"
        Title="Controle Financeiro" Height="700" Width="1024"
        Background="#f8f8fa">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectionChanged="TabControl_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="10">
            <TabItem Header="Dashboard" FontSize="16">
                <dashboard:DashboardView x:Name="DashboardViewControl" />
            </TabItem>
            <TabItem Header="Categorias" FontSize="16">
                <categories:CategoriesView x:Name="CategoriesViewControl" />
            </TabItem>
            <TabItem Header="Importar Transa&#231;&#245;es" FontSize="16">
                <import:ImportTransactionsView x:Name="ImportTransactionsViewControl" />
            </TabItem>
            <TabItem Header="Parcelamentos" FontSize="16">
                <parc:ParcelamentosView x:Name="ParcelamentosViewControl" />
            </TabItem>
            <TabItem Header="Meus Investimentos" FontSize="16">
                <inv:InvestmentsView x:Name="InvestmentsViewControl" />
            </TabItem>
        </TabControl>

        <!-- Footer com botao de acesso rapido aos logs -->
        <Border Grid.Row="1" Background="#f0f0f5" BorderBrush="#dedee5" BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenLogsButton"
                        Content="&#128194; Abrir pasta de logs"
                        Click="OpenLogsButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#686b82" FontSize="12" Cursor="Hand"
                        Padding="8,4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
