<UserControl x:Class="ControleFinanceiroForms.Features.Categories.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControleFinanceiroForms.Features.Categories"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#ffffff">
             
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Categorias e Metas" 
                       FontSize="36" FontWeight="Bold" Foreground="#101114" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Gerencie suas categorias de gastos e defina limites mensais." 
                       FontSize="16" Foreground="#686b82" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Nome da Categoria" FontSize="14" Foreground="#101114" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8" FontSize="16" BorderBrush="#dedee5" BorderThickness="1"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="Limite (Opcional)" FontSize="14" Foreground="#101114" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewCategoryBudget, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="8" FontSize="16" BorderBrush="#dedee5" BorderThickness="1"/>
            </StackPanel>
            
            <Button Grid.Column="2" Content="Adicionar" VerticalAlignment="Bottom"
                    Command="{Binding AddCategoryCommand}"
                    Background="#7132f5" Foreground="#ffffff" 
                    FontSize="16" FontWeight="SemiBold" 
                    Padding="16,10" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
        
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#e02020" FontSize="14" Margin="0,70,0,0" VerticalAlignment="Bottom" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Categories}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" Background="#ffffff" BorderBrush="#dedee5" 
                  RowBackground="#ffffff" AlternatingRowBackground="#f8f8fa" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#dedee5"
                  RowEditEnding="DataGrid_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" />
                <DataGridTextColumn Header="Limite Orçamentário" Binding="{Binding BudgetLimit, UpdateSourceTrigger=LostFocus}" Width="200" />
                <DataGridTemplateColumn Header="Ações" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Excluir" Background="Transparent" Foreground="#7132f5" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
